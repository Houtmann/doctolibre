{{define "title"}}Invitation à rejoindre {{.practice_name}}{{end}}
{{define "content"}}
<h1 style="margin:0 0 16px;font-size:20px;">Invitation à rejoindre {{.practice_name}}</h1>
<p style="margin:0 0 16px;">Bonjour,</p>
<p style="margin:0 0 16px;">Vous êtes invité(e) à rejoindre l'équipe de {{.practice_name}} sur Doctolibre, avec le rôle : {{.role_label}}. Ce lien est valable {{.valid_for}} et ne peut servir qu'une fois.</p>
<table role="presentation" cellpadding="0" cellspacing="0" style="margin:0 0 16px;"><tr>
<td style="background-color:#0b5fa5;border-radius:4px;"><a href="{{.accept_url}}" style="display:inline-block;padding:12px 20px;font-family:Arial,Helvetica,sans-serif;font-size:16px;color:#ffffff;text-decoration:none;">Activer mon compte</a></td>
</tr></table>
<p style="margin:0 0 16px;font-size:14px;">Si le bouton ne fonctionne pas, copiez cette adresse dans votre navigateur :<br>{{.accept_url}}</p>
<p style="margin:0;font-size:14px;">Si vous ne connaissez pas ce cabinet, ignorez simplement cet email : aucun compte ne sera créé.</p>
{{end}}
