# TLS automatique (Let's Encrypt) pour {$DOMAIN}. Les en-têtes de sécurité (CSP,
# HSTS...) sont posés par l'application : ne pas les dupliquer ici.
#
# Test local sans domaine public : dans deploy/.env, mettre
#   DOMAIN=localhost
#   CADDY_TLS=internal
# (certificat auto-signé par la CA interne de Caddy).
# En prod, CADDY_TLS = email ACME de l'exploitant (ex. admin@exemple.fr) : certificat Let's Encrypt.
{$DOMAIN} {
	tls {$CADDY_TLS}
	encode zstd gzip
	# Caddy REMPLACE X-Forwarded-For envoyé par le client (il ne fait confiance à aucun
	# proxy amont par défaut) : l'appli lit donc l'IP réelle en fin de chaîne. Ne pas
	# ajouter `trusted_proxies` sans mettre à jour DOCTOLIBRE_TRUSTED_PROXIES.
	reverse_proxy app:8080 {
		header_up X-Forwarded-For {remote_host}
	}
}
