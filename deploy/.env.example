# Production (docker compose) : cp .env.example .env, puis éditer. Ne JAMAIS committer .env.
# Variables lues par docker-compose.yml (les DOCTOLIBRE_* sont transmises à l'application).

# --- Compose / Caddy ---
# Nom de domaine public (DNS A/AAAA vers ce serveur, ports 80 et 443 ouverts).
DOMAIN=rdv.example.fr
# Obligatoire. Email ACME de l'exploitant (certificat Let's Encrypt), ou "internal" (auto-signé, test local avec DOMAIN=localhost).
CADDY_TLS=admin@example.fr
# Image de l'application (défaut : ghcr.io/doctolibre/doctolibre:latest).
#DOCTOLIBRE_IMAGE=ghcr.io/doctolibre/doctolibre:v0.1.0
# Mot de passe de la base PostgreSQL (openssl rand -hex 24).
POSTGRES_PASSWORD=

# --- Application (internal/config) ---
# Obligatoire, 32 octets minimum : openssl rand -hex 32
# Changer cette clé invalide tous les liens de gestion déjà envoyés aux patients.
DOCTOLIBRE_SECRET_KEY=
# Fuseau du cabinet (calcul des créneaux, affichage). Défaut : Europe/Paris.
DOCTOLIBRE_TIMEZONE=Europe/Paris
# Applique les migrations au démarrage de `serve`. Défaut : true.
DOCTOLIBRE_AUTO_MIGRATE=true
# Jeton Bearer de /metrics (16 octets minimum) ; vide = /metrics désactivé.
DOCTOLIBRE_METRICS_TOKEN=
# Active le suivi des sauvegardes (page /admin/status, alerte email après 48 h sans sauvegarde).
# Avec le service de sauvegarde (COMPOSE_PROFILES=backup), mettre /backups ; vide = pas de suivi.
DOCTOLIBRE_BACKUP_DIR=

# Worker outbox (envoi des emails/SMS) dans `serve` : on | off. Défaut : on.
DOCTOLIBRE_WORKER=on

# --- Email (docs/email.md) ---
# Driver : smtp (envoi réel) ou log (n'envoie rien ; déconseillé en production). Défaut ici : smtp.
DOCTOLIBRE_EMAIL_DRIVER=smtp
# Serveur SMTP (obligatoire avec smtp).
DOCTOLIBRE_SMTP_HOST=smtp.example.fr
# Port ; défaut selon DOCTOLIBRE_SMTP_TLS : 587 (starttls), 465 (tls), 25 (none).
DOCTOLIBRE_SMTP_PORT=587
# Identifiants SMTP (vont ensemble ; vides = pas d'authentification).
DOCTOLIBRE_SMTP_USER=
DOCTOLIBRE_SMTP_PASSWORD=
# Expéditeur (obligatoire avec smtp), ex. Cabinet Dupont <rdv@cabinet-dupont.fr>.
DOCTOLIBRE_SMTP_FROM=Cabinet Exemple <rdv@example.fr>
# Chiffrement : starttls (défaut), tls ou none (jamais en production).
DOCTOLIBRE_SMTP_TLS=starttls
# Driver log uniquement : dossier des .eml écrits.
#DOCTOLIBRE_EMAIL_LOG_DIR=tmp/mails

# Fournisseurs email/SMS propres à un cabinet (réglés dans l'administration) : false (défaut) refuse
# les adresses privées, de bouclage et link-local ainsi que le HTTP en clair. true pour une passerelle Android sur le réseau local.
#DOCTOLIBRE_NOTIFY_ALLOW_PRIVATE_HOSTS=false

# --- SMS (docs/sms.md) ---
# Driver : log (défaut, n'envoie rien) | http | android | ovh.
DOCTOLIBRE_SMS_DRIVER=log
# Expéditeur alphanumérique (OVH, ou {{.Sender}} du driver http). Ignoré par android.
DOCTOLIBRE_SMS_SENDER=
# true (défaut) : translittère (ê->e, œ->oe…) pour rester en GSM-7 (1 segment).
DOCTOLIBRE_SMS_TRANSLITERATE=true
# Driver ovh : service, clés d'application et consumer key (droit POST /sms/*).
DOCTOLIBRE_SMS_OVH_SERVICE=
DOCTOLIBRE_SMS_OVH_APP_KEY=
DOCTOLIBRE_SMS_OVH_APP_SECRET=
DOCTOLIBRE_SMS_OVH_CONSUMER_KEY=
# Optionnel, défaut https://eu.api.ovh.com/1.0
#DOCTOLIBRE_SMS_OVH_ENDPOINT=
# Driver android : URL locale du téléphone (ex. http://192.168.1.20:8080) ; vide = cloud.
DOCTOLIBRE_SMS_ANDROID_URL=
DOCTOLIBRE_SMS_ANDROID_USER=
DOCTOLIBRE_SMS_ANDROID_PASSWORD=
# Driver http (générique, ex. Twilio) : URL et corps (text/template) obligatoires.
DOCTOLIBRE_SMS_HTTP_URL=
DOCTOLIBRE_SMS_HTTP_METHOD=POST
# En-têtes : objet JSON, ex. {"Content-Type":"application/json"}
DOCTOLIBRE_SMS_HTTP_HEADERS=
DOCTOLIBRE_SMS_HTTP_BODY=
DOCTOLIBRE_SMS_HTTP_BASIC_USER=
DOCTOLIBRE_SMS_HTTP_BASIC_PASSWORD=
DOCTOLIBRE_SMS_HTTP_BEARER=

# --- Sauvegardes chiffrées (docs/backup.md) ---
# Active le service `backup` (une sauvegarde par jour). Retirer cette ligne désactive les sauvegardes.
COMPOSE_PROFILES=backup
# OBLIGATOIRE avec le profil backup : clé PUBLIQUE age (age-keygen ; garder la clé privée HORS du serveur).
DOCTOLIBRE_BACKUP_AGE_RECIPIENT=
# Heure UTC de la sauvegarde quotidienne, et rétention locale (jours / semaines).
#BACKUP_TIME=03:30
#BACKUP_KEEP_DAILY=7
#BACKUP_KEEP_WEEKLY=4
# Envoi hors serveur (optionnel), stockage S3-compatible (Scaleway, OVH, Backblaze B2...).
#DOCTOLIBRE_BACKUP_S3_ENDPOINT=https://s3.fr-par.scw.cloud
#DOCTOLIBRE_BACKUP_S3_BUCKET=
#DOCTOLIBRE_BACKUP_S3_ACCESS_KEY=
#DOCTOLIBRE_BACKUP_S3_SECRET_KEY=
#DOCTOLIBRE_BACKUP_S3_REGION=fr-par
#DOCTOLIBRE_BACKUP_S3_PREFIX=doctolibre

# --- Fixées par docker-compose.yml (ne pas définir ici avec Docker) ---
# DOCTOLIBRE_ENV=prod                       dev | prod (prod : HSTS, cookies Secure, JSON logs)
# DOCTOLIBRE_HTTP_ADDR=:8080                adresse d'écoute
# DOCTOLIBRE_BASE_URL=https://$DOMAIN       URL publique (obligatoire en prod)
# DOCTOLIBRE_DATABASE_URL=postgres://...    DSN PostgreSQL (obligatoire en prod)
# DOCTOLIBRE_TRUSTED_PROXIES=172.30.0.0/24  CIDR des reverse proxies dont X-Forwarded-For est cru
#
# Variante systemd (sans Docker) : voir deploy/doctolibre.service. Définir alors ces variables dans
# /etc/doctolibre/doctolibre.env ; DOCTOLIBRE_TRUSTED_PROXIES vaut 127.0.0.1/32 si Caddy/nginx est local.
