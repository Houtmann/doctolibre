# Copier en .env pour le développement (chargé uniquement si DOCTOLIBRE_ENV=dev).
DOCTOLIBRE_ENV=dev
DOCTOLIBRE_HTTP_ADDR=:8080
DOCTOLIBRE_BASE_URL=http://localhost:8080
DOCTOLIBRE_DATABASE_URL=postgres://doctolibre:doctolibre@localhost:5432/doctolibre?sslmode=disable
# Obligatoire partout, 32 octets minimum (ex: openssl rand -hex 32). Les liens de gestion
# des rendez-vous en sont dérivés : changer la clé invalide tous les liens déjà envoyés.
# Valeur de développement uniquement.
DOCTOLIBRE_SECRET_KEY=dev-only-secret-key-do-not-use-in-prod-0123456789
DOCTOLIBRE_TIMEZONE=Europe/Paris
